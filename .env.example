# ── Django Core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Default local development uses SQLite. Set USE_POSTGRES=True to use Postgres.
USE_POSTGRES=False
DB_NAME=tawatur_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: OTP storage, rate limiting, Celery broker/result backend
REDIS_URL=redis://127.0.0.1:6379/0

# ── Encryption Key ────────────────────────────────────────────────────────────
# Used to encrypt IMEI, serial numbers, phone numbers, national IDs at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ── AWS S3 (for PDF certificates & QR codes) ─────────────────────────────────
# Leave empty in development to use local file storage instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
